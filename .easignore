# EAS upload ignore list. When this file exists EAS CLI uses it INSTEAD of
# .gitignore, so it mirrors .gitignore and adds the local screenshot harness.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (release env comes from the EAS environment, not the upload)
.env
.env*.local

# typescript
*.tsbuildinfo

# local Claude Code settings
.claude/settings.json
.claude/settings.local.json

# generated native folders
/ios
/android

# local screenshot harness (never shipped)
App.harness.tsx
