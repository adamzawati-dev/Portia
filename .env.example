# Supabase — copy this file to .env.local and fill in your project's values.
# Both are EXPO_PUBLIC_* so they're inlined into the client bundle. The anon
# (publishable) key is designed to be shipped in the client; it is NOT a secret.
# Find both in the Supabase dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY
